{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "co_leader",
        "teacher",
        "co_teacher",
        "event_volunteer",
        "board_rep",
        "parent"
      ],
      "default": "event_volunteer",
      "description": "User role"
    },
    "assigned_class_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assigned class IDs (for teachers/co-teachers)"
    },
    "assigned_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assigned event IDs (for volunteers)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Active status"
    }
  }
}