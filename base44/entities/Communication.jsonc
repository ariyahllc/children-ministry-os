{
  "name": "Communication",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Parent Email",
        "WhatsApp Message",
        "Teacher Update",
        "Board Update"
      ],
      "description": "Communication type"
    },
    "audience": {
      "type": "string",
      "description": "Target audience"
    },
    "subject": {
      "type": "string",
      "description": "Subject line"
    },
    "content": {
      "type": "string",
      "description": "Message content"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent",
        "Scheduled"
      ],
      "default": "Draft",
      "description": "Status"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date sent or scheduled"
    }
  },
  "required": [
    "subject"
  ]
}