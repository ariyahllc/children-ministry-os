{
  "name": "Document",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "category": {
      "type": "string",
      "enum": [
        "Registration",
        "Curriculum",
        "Board Reports",
        "Events",
        "Communications"
      ],
      "description": "Category"
    },
    "event_id": {
      "type": "string",
      "description": "Related event ID"
    },
    "tags": {
      "type": "string",
      "description": "Tags (comma-separated)"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded file URL"
    },
    "notes": {
      "type": "string",
      "description": "Notes"
    }
  },
  "required": [
    "title"
  ]
}