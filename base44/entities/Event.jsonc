{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Event name"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "type": {
      "type": "string",
      "enum": [
        "VBS",
        "Children's Sunday",
        "Offertory",
        "Outreach",
        "Conference",
        "Special",
        "Other"
      ],
      "description": "Event type"
    },
    "description": {
      "type": "string",
      "description": "Event description"
    },
    "budget": {
      "type": "number",
      "description": "Budget amount"
    },
    "attendance_count": {
      "type": "number",
      "description": "Attendance count"
    },
    "volunteers_assigned": {
      "type": "string",
      "description": "Comma-separated volunteer IDs"
    },
    "status": {
      "type": "string",
      "enum": [
        "Planning",
        "Upcoming",
        "In Progress",
        "Completed",
        "Cancelled"
      ],
      "default": "Planning",
      "description": "Event status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "name",
    "date"
  ]
}