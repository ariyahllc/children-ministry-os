{
  "name": "Volunteer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "availability": {
      "type": "string",
      "enum": [
        "Weekdays",
        "Weekends",
        "Both",
        "On Call"
      ],
      "description": "Availability"
    },
    "skills": {
      "type": "string",
      "description": "Skills and abilities"
    },
    "background_check": {
      "type": "string",
      "enum": [
        "Pending",
        "Cleared",
        "Expired",
        "Not Started"
      ],
      "default": "Not Started",
      "description": "Background check status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "name"
  ]
}