{
  "name": "Child",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Child's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Child's last name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Male",
        "Female"
      ],
      "description": "Gender"
    },
    "class_id": {
      "type": "string",
      "description": "Assigned class ID"
    },
    "parent_id": {
      "type": "string",
      "description": "Parent ID"
    },
    "allergies": {
      "type": "string",
      "description": "Known allergies"
    },
    "medical_notes": {
      "type": "string",
      "description": "Medical notes"
    },
    "photo_consent": {
      "type": "boolean",
      "default": false,
      "description": "Photo consent granted"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Inactive"
      ],
      "default": "Active",
      "description": "Status"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}